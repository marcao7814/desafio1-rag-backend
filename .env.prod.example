# ============================================================
# .env de PRODUÇÃO (VPS) — modelo. Nunca commitar o .env real.
# Usado por docker-compose.prod.yml (serviços "ragdb" e "web").
# ============================================================

# Provedor de LLM e Embeddings
LLM_PROVIDER=ollama

# Ollama compartilhado com o projeto EAD na mesma VPS (rede "ead_default").
# Usa o container_name "ead-ollama-1", não o alias de serviço "ollama" —
# ver comentário em docker-compose.prod.yml sobre colisão de nomes entre projetos.
OLLAMA_BASE_URL=http://ead-ollama-1:11434
OLLAMA_MODEL=llama3.2
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Banco (container "ragdb" deste compose — nome único para não colidir com o
# serviço "db" do projeto EAD na rede "ead_default" compartilhada).
# IMPORTANTE: python-dotenv não faz interpolação de variáveis — repita a MESMA
# senha em POSTGRES_PASSWORD e dentro de DATABASE_URL, não use ${...} aqui.
POSTGRES_DB=ragdb
POSTGRES_USER=postgres
POSTGRES_PASSWORD=<senha-gerada>
DATABASE_URL=postgresql+psycopg://postgres:<senha-gerada>@ragdb:5432/ragdb

# Configurações de ingestão
CHUNK_SIZE=1000
CHUNK_OVERLAP=100
COLLECTION_NAME=documentos_rag

# Autenticação / sessão
SECRET_KEY=
# 0 até o certificado HTTPS estar ativo (passo 4 do deploy); depois trocar para 1
SESSION_COOKIE_SECURE=0

FLASK_PORT=5000
