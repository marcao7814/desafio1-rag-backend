# ============================================================
# Provedor de LLM e Embeddings: "openai", "gemini" ou "ollama"
# ============================================================
LLM_PROVIDER=openai

# ============================================================
# Credenciais OpenAI (necessárias se LLM_PROVIDER=openai)
# ============================================================
OPENAI_API_KEY=sk-...

# ============================================================
# Credenciais Gemini (necessárias se LLM_PROVIDER=gemini)
# ============================================================
GOOGLE_API_KEY=AIza...

# ============================================================
# Ollama (necessário se LLM_PROVIDER=ollama)
# Requer o servidor Ollama rodando localmente (ollama serve)
# com os modelos já baixados (ex.: ollama pull llama3.2 / ollama pull nomic-embed-text)
# ============================================================
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# ============================================================
# Conexão com PostgreSQL (pgVector via Docker)
# ============================================================
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/ragdb

# ============================================================
# Nome da coleção no banco vetorial
# ============================================================
COLLECTION_NAME=documentos_rag

# ============================================================
# Caminho do PDF a ser ingerido
# ============================================================
PDF_PATH=document.pdf

# ============================================================
# Autenticação / sessão (login)
# SECRET_KEY: gerar com -> python -c "import secrets; print(secrets.token_hex(32))"
# SESSION_COOKIE_SECURE: 0 em dev local (HTTP), 1 em produção (HTTPS)
# ============================================================
SECRET_KEY=
SESSION_COOKIE_SECURE=0
